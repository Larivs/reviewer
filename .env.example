# Copier ce fichier en `.env.local`, il n'est jamais suivi par git.
# Aucune variable n'est obligatoire : l'app démarre telle quelle.

# ── Authentification ────────────────────────────────────────────────────
# 1 = aucun écran de connexion, et donc AUCUN contrôle d'accès.
# Réservé au développement en local. `npm run serve` refuse de démarrer
# tant que ce drapeau vaut 1.
AUTH_DISABLED=0

# ── Affichage des dates ─────────────────────────────────────────────────
# Fuseau utilisé pour afficher les dates des notes. Il doit être explicite :
# le rendu se fait côté serveur puis côté navigateur, et deux fuseaux
# différents produiraient une incohérence d'hydratation React.
# Préfixe NEXT_PUBLIC_ obligatoire, la valeur est lue des deux côtés.
# Par défaut : Europe/Paris.
NEXT_PUBLIC_REVIEWER_TIMEZONE=Europe/Paris

# Langue utilisée pour formater dates et nombres. L'interface, elle, est
# en français et n'est pas traduite. Par défaut : fr-FR.
NEXT_PUBLIC_REVIEWER_LOCALE=fr-FR

# ── Notifications ───────────────────────────────────────────────────────
# Adresse appelée à chaque nouvelle note, réponse ou changement de statut.
# Un webhook entrant Slack ou Discord convient tel quel. Vide = rien n'est
# envoyé, et rien ne sort de la machine.
REVIEWER_WEBHOOK_URL=

# Adresse à laquelle les autres ouvrent l'app, pour que la notification
# porte un lien vers la vidéo. Sans elle, le message arrive sans lien.
# Exemple : https://review.mon-studio.fr
REVIEWER_PUBLIC_URL=

# Courriel : prévient le studio à chaque nouvelle note, et toute personne
# mentionnée par @. Adresse de connexion SMTP complète. Vide = aucun courriel.
# Chaque compte doit avoir une adresse, réglée depuis la page Comptes.
# Exemple : smtps://utilisateur:motdepasse@smtp.exemple.fr:465
REVIEWER_SMTP_URL=

# Expéditeur affiché. Par défaut : Reviewer <reviewer@localhost>, que la
# plupart des serveurs refuseront : mets une adresse de ton domaine.
REVIEWER_MAIL_FROM=
